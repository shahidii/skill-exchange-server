NODE_ENV=development
PORT=8080
MONGO_URI_LOCAL=mongodb://localhost:27017/skillswap
JWT_SECRET=secretcode
JWT_EXPIRES_IN=1m
# Redis
REDIS_LOCAL_URL=redis://localhost:6379
REDIS_HOST=your-cloud-hostname
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-strong-password
REDIS_URL=redis://default:your-strong-password@your-cloud-hostname:6379

# SMTP (if you want actual email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM="SkillSwap <no-reply@skillswap.com>"


# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key
